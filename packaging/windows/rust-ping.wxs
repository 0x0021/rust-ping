<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="rust-ping"
      Manufacturer="0x0021"
      Version="$(var.Version)"
      UpgradeCode="7F4C1E9A-3B62-4D18-9A0C-6E2D5B81F4A7"
      Language="1033"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon" SourceFile="assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="rust-ping">
        <Component Id="MainExecutable" Guid="*">
          <File Id="rustPingExe" Source="target/release/rust-ping.exe" KeyPath="yes" />
        </Component>
        <Component Id="Readme" Guid="*">
          <File Id="ReadmeFile" Source="README.md" KeyPath="yes" />
        </Component>
        <Component Id="ExampleConfig" Guid="*">
          <File Id="ExampleConfigFile" Source="config.example.toml" KeyPath="yes" />
        </Component>
        <Component Id="AppIcon" Guid="*">
          <File Id="AppIconFile" Source="assets/icon.png" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="rust-ping" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="ExampleConfig" />
      <ComponentRef Id="AppIcon" />
    </Feature>
  </Package>
</Wix>
